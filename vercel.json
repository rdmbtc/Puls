{
  "buildCommand": "bash build_vercel.sh",
  "outputDirectory": "build/web",
  "installCommand": "echo 'skip'",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "pulsmarket.tech" }],
      "destination": "https://app.pulsmarket.tech/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "pulsmarket.tech" }],
      "destination": "https://app.pulsmarket.tech/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/m/:slug", "destination": "/api/market-share?slug=:slug" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
